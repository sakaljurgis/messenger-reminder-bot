# The apiToken returned when creating the bot (Settings -> Bots, shown once). Required.
BOT_TOKEN=

# Where the messenger API lives. Prod: https://msg.example.com
MESSENGER_URL=http://localhost:3001

# Any OpenAI-compatible Chat Completions provider. Examples:
#   Ollama (default):  http://localhost:11434/v1   model: qwen2.5:3b
#   OpenAI:            https://api.openai.com/v1   model: gpt-4.1-mini   (needs LLM_API_KEY)
#   OpenRouter:        https://openrouter.ai/api/v1                      (needs LLM_API_KEY)
# (Legacy OLLAMA_URL / OLLAMA_MODEL / OLLAMA_TIMEOUT_MS still work as aliases;
#  OLLAMA_URL gets the /v1 suffix appended automatically.)
LLM_BASE_URL=http://ollama.server:port/v1
LLM_MODEL=qwen2.5:3b
# Sent as "Authorization: Bearer <key>" only when set (Ollama needs none).
#LLM_API_KEY=

# Per-attempt abort. Timeouts are NOT retried (a killed client does not stop
# a CPU-bound Ollama generation — retries queue-starve the box).
#LLM_TIMEOUT_MS=90000

# Thinking control, passed through verbatim as `reasoning_effort` (replaces
# the retired OLLAMA_THINK; a legacy OLLAMA_THINK=false still maps to "none").
# Ollama: none/low/medium/high/max, mapped onto native thinking — "none"
# disables it on qwen3-family/gemma models. OpenAI: minimal/low/medium/high.
# Leave unset for models without a thinking switch (qwen2.5) — Ollama rejects
# it on models that can't think.
#LLM_REASONING_EFFORT=none

# FALLBACK IANA timezone. Messages sent from the app carry the sender's own
# device zone (MessageDTO.senderTimezone) and the bot uses that; this value
# only covers messages without one (older clients, direct API sends).
#USER_TIMEZONE=Europe/Vilnius

# Webhook listener port (the bot's webhookUrl must point here).
#PORT=4002

# Optional bootstrap for the bot's own user id (reliable group @mention
# detection). Normally unnecessary — the bot fetches it from GET /api/bot/me
# on the first group message, and only falls back to matching "@<BOT_NAME>"
# text against an older server without that route. Set it to skip the lookup.
#BOT_USER_ID=
#BOT_NAME=Reminder
