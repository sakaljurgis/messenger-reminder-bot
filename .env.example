# The apiToken returned when creating the bot (Settings -> Bots, shown once). Required.
BOT_TOKEN=

# Where the messenger API lives. Prod: https://msg.sklk.lt
MESSENGER_URL=http://localhost:3001

# Ollama endpoint + model used to parse reminder requests.
# qwen2.5:3b won the live A/B (fast + accurate); lfm2.5-thinking:latest was
# 10-20x slower and garbled the fields — see PLAN.md amendment 12.
OLLAMA_URL=http://ollama.server.sklk.lt
OLLAMA_MODEL=qwen2.5:3b
#OLLAMA_TIMEOUT_MS=90000
# For models with a thinking switch (qwen3 family): "false" disables thinking
# cleanly. Leave unset for models without one (qwen2.5) — Ollama errors on an
# unsupported `think` field. Never set for lfm2.5 (leaks <think> into output).
#OLLAMA_THINK=false

# FALLBACK IANA timezone. Messages sent from the app carry the sender's own
# device zone (MessageDTO.senderTimezone) and the bot uses that; this value
# only covers messages without one (older clients, direct API sends).
#USER_TIMEZONE=Europe/Vilnius

# Webhook listener port (the bot's webhookUrl must point here).
#PORT=4002

# The bot's own user id — enables reliable @mention detection in group chats.
# Without it the bot falls back to matching "@<BOT_NAME>" in the text.
#BOT_USER_ID=
#BOT_NAME=Reminder
